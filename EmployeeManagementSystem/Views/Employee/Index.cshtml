@model IEnumerable<EmployeeManagementSystem.Models.Employee>

@{
    ViewData["Title"] = "Employee List";
}

<h2 class="mb-3">Employee Management</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        Add New Employee
    </a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text"
               name="searchTerm"
               value="@ViewBag.SearchTerm"
               class="form-control"
               placeholder="Search by name, email or phone..." />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-success">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<p><strong>Total records:</strong> @Model.Count()</p>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Sr. No.</th>
                <th>Employee ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Date of Birth</th>
                <th>Country</th>
                <th>State</th>
                <th>City</th>
                <th>Qualification</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                int serialNumber = 1;

                @foreach (var employee in Model)
                {
                    <tr>
                        <td>@serialNumber</td>
                        <td>@employee.EmployeeId</td>
                        <td>@employee.FirstName</td>
                        <td>@employee.LastName</td>
                        <td>@employee.DateOfBirth.ToString("dd-MM-yyyy")</td>
                        <td>@employee.CountryName</td>
                        <td>@employee.StateName</td>
                        <td>@employee.CityName</td>
                        <td>@employee.QualificationName</td>
                        <td>@employee.EmailAddress</td>
                        <td>@employee.PhoneNo</td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@employee.EmployeeId"
                               class="btn btn-info btn-sm">View</a>

                            <a asp-action="Edit"
                               asp-route-id="@employee.EmployeeId"
                               class="btn btn-warning btn-sm">Edit</a>

                            <a asp-action="Delete"
                               asp-route-id="@employee.EmployeeId"
                               class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>

                    serialNumber++;
                }
            }
            else
            {
                <tr>
                    <td colspan="12" class="text-center">
                        No employees found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
