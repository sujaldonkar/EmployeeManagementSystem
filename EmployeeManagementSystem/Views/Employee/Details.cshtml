@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h2>Employee Details</h2>
<hr />

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Employee ID</dt>
            <dd class="col-sm-9">@Model.EmployeeId</dd>

            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>

            <dt class="col-sm-3">Last Name</dt>
            <dd class="col-sm-9">@Model.LastName</dd>

            <dt class="col-sm-3">Date of Birth</dt>
            <dd class="col-sm-9">@Model.DateOfBirth.ToString("dd-MM-yyyy")</dd>

            <dt class="col-sm-3">Country</dt>
            <dd class="col-sm-9">@Model.CountryName</dd>

            <dt class="col-sm-3">State</dt>
            <dd class="col-sm-9">@Model.StateName</dd>

            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">@Model.CityName</dd>

            <dt class="col-sm-3">Qualification</dt>
            <dd class="col-sm-9">@Model.QualificationName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.EmailAddress</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.PhoneNo</dd>

        </dl>

        <a asp-action="Edit" asp-route-id="@Model.EmployeeId"
           class="btn btn-warning">Edit</a>

        <a asp-action="Index" class="btn btn-secondary">Back to List</a>

    </div>
</div>
